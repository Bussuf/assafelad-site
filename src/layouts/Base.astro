---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Hotbar from '../components/Hotbar.astro';
import Footer from '../components/Footer.astro';
import Ukulele from '../components/Ukulele.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { navKeyOf, stripBase, withBase } from '../lib/nav';
import { findImage } from '../lib/images';
import { absoluteUrl } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** the picture a shared link shows; a project passes its hero, every other page gets the default */
  image?: ImageMetadata;
  /** kept out of search engines even on the real domain (the 404 page) */
  noindex?: boolean;
}

const { title, description = 'Assaf Elad, also known as Bussuf: music, games I made, and apps I built.', noindex = false } = Astro.props;
const current = navKeyOf(Astro.url.pathname);
const isHome = stripBase(Astro.url.pathname) === '/';
const pageTitle = isHome ? title : `${title} | Assaf Elad`;

// Open Graph (#6): the link preview in WhatsApp, LinkedIn and search. 1200x630 is the size every one of them shows
// without cropping again. The default is the Now photo (his pick); its middle crop is the face (checked).
// ("attention" cropping picked the columns behind him instead.)
const site = Astro.site!;
const canonical = absoluteUrl(Astro.url.pathname, site);
const shareSrc = Astro.props.image ?? findImage('about-02.jpg');
const share = shareSrc ? await getImage({ src: shareSrc, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : undefined;
const shareUrl = share ? absoluteUrl(share.src, site) : undefined;
---

<!-- No cross-page animation: it made fast tab switching wait. Pages get their own entrance motion instead. -->
<html lang="en" dir="ltr" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* the 404 page answers for any address: no canonical of its own */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {/* temporary address (#7): kept out of search engines until the real domain (#8) */}
    {(noindex || import.meta.env.BASE_URL !== '/') && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Assaf Elad" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      share && shareUrl && (
        <>
          <meta property="og:image" content={shareUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${title}, Assaf Elad`} />
        </>
      )
    }
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
    <meta name="generator" content={Astro.generator} />
    {/* the phone's browser bar takes the page color; the script below and the toggle keep it with the theme */}
    <meta name="theme-color" content="#141b26" data-theme-color />

    <Font cssVariable="--font-rubik" preload={[{ subset: 'latin' }]} />
    <!-- Before first paint: dark unless the visitor chose light. Re-applied after every page swap. -->
    <script is:inline>
      (() => {
        const theme = () => {
          try {
            if (localStorage.getItem('assaf-theme') === 'light') return 'light';
          } catch {}
          return 'dark';
        };
        // the paper colors in global.css; ui.ts sets the same pair on the toggle
        const bar = (doc, t) => doc.querySelector('[data-theme-color]')?.setAttribute('content', t === 'light' ? '#ffffff' : '#141b26');
        document.documentElement.dataset.theme = theme();
        bar(document, theme());
        if (!window.__assafTheme) {
          window.__assafTheme = true;
          // mark the NEW page before it is shown: setting it after the swap flashed dark for a moment in light mode,
          // and Android repainted its system bar each time (his note)
          document.addEventListener('astro:before-swap', (e) => {
            e.newDocument.documentElement.dataset.theme = theme();
            bar(e.newDocument, theme());
          });
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <a
      href="#main"
      class="sr-only z-20 rounded-md bg-raise px-3 py-2 text-ink focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      data-sound="none">Skip to content</a
    >
    <Header current={current} />
    <main id="main" class="mx-auto w-full max-w-[1440px] flex-1 px-4 pb-28 nav:px-8 nav:pb-6">
      <slot />
    </main>
    <Footer />
    <Hotbar current={current} />
    <Ukulele />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>

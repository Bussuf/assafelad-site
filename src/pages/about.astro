---
import Base from '../layouts/Base.astro';
import ThenNow from '../components/about/ThenNow.astro';
import Topics from '../components/about/Topics.astro';
import TextTodo from '../components/TextTodo.astro';
import { INTRO } from '../data/about';
---

<!-- Three columns in one screen on a computer (#12, his pick from the mockup): photo and intro | topics | panel.
     On a phone they stack, and each panel ends with a button back up to the topics. -->
<Base title="About" description="Assaf Elad, also known as Bussuf: music, making games, apps, AI talks, Excel and the games I play.">
  <div class="k-about about-page">
    <section class="me">
      <div class="photo" data-a="pop"><ThenNow /></div>
      <div>
        <h1 class="mt-0 mb-1.5 text-[clamp(34px,4vw,48px)] leading-[1.05] font-extrabold tracking-[-0.015em]" data-a="left" style="--d:90ms">
          About
        </h1>
        <p class="mb-2.5 text-[17px] leading-normal" data-a="left" style="--d:150ms">
          Most of my friends call me <b class="font-semibold text-plum">Bussuf</b>. I have been fascinated by computers and everything
          they can do since I was a kid.
        </p>
        <div data-a="up" style="--d:230ms"><TextTodo what={INTRO.todo.what} words={INTRO.todo.words} lines={2} /></div>
      </div>
    </section>

    <section class="what" aria-labelledby="what-title">
      <h2 id="what-title" class="what-title" data-a="left">What I do, and what I play</h2>
      <Topics />
    </section>
  </div>
</Base>

<style>
  .about-page { display: flex; flex-direction: column; gap: 22px; padding: 22px 0 10px; }
  .me { display: grid; gap: 18px; }
  .photo { max-width: 200px; }
  .what-title { margin: 0 0 10px; padding-bottom: 4px; border-bottom: 1px solid var(--rule); font-size: 20px; font-weight: 600; scroll-margin-top: 70px; }

  @media (min-width: 43.75rem) {
    .about-page {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 26px;
      height: calc(100dvh - 160px);
      min-height: 520px;
      padding: 18px 0 0;
    }
    .me { align-content: start; gap: 14px; }
    .photo { max-width: none; }
    .what { min-height: 0; display: flex; flex-direction: column; }
    /* on a computer the columns say it already; the heading stays for screen readers */
    .what-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
</style>

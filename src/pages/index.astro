---
import Base from '../layouts/Base.astro';
import Banner from '../components/home/Banner.astro';
import Door from '../components/home/Door.astro';
import { DOORS } from '../data/home';
import { allProjects } from '../lib/projects';

const projects = await allProjects();

const doors = DOORS.map((door) => {
  const items = projects.filter((p) => p.data.door === door.key);
  const featured = items.filter((p) => p.data.featured);
  // The "Start here" line needs exactly one; fail the build instead of showing the wrong project.
  if (featured.length !== 1) {
    throw new Error(`Door "${door.key}" needs exactly one featured project, found ${featured.length}`);
  }
  return { door, items };
});
const motions = ['drop', 'up', 'drop'] as const;
---

<Base title="Assaf Elad">
  <Banner />
  <section
    class="grid grid-cols-1 gap-3.5 pb-10 nav:grid-cols-3 nav:gap-[18px]"
    aria-label="Doors"
  >
    {doors.map(({ door, items }, i) => <Door door={door} items={items} motion={motions[i]!} delay={350 + i * 220} />)}
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="Play games">
  <!-- Temporary page so the nav can be checked; the real page comes in step 4. -->
  <section class="k-games py-10">
    <h1 class="flex items-center gap-3 text-[clamp(34px,6vw,56px)] leading-tight font-extrabold tracking-tight">
      <span class="h-[30px] w-3 flex-none rounded-[3px] bg-door" aria-hidden="true"></span>Play games
    </h1>
    <p class="text-[17px] text-soft">Games I made in Unity, from small classics to ChessLord.</p>
    <p class="mt-4 text-soft">[Games page: step 4]</p>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---

<Base title="Music">
  <!-- Temporary page so the nav can be checked; the real page comes in step 4. -->
  <section class="k-music py-10">
    <h1 class="flex items-center gap-3 text-[clamp(34px,6vw,56px)] leading-tight font-extrabold tracking-tight">
      <span class="h-[30px] w-3 flex-none rounded-[3px] bg-door" aria-hidden="true"></span>Music
    </h1>
    <p class="text-[17px] text-soft">Sing-alongs, guitar lessons, songs of my own, and a band on a break.</p>
    <p class="mt-4 text-soft">[Music page: step 4]</p>
  </section>
</Base>

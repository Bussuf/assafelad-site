---
import Icon from './Icon.astro';
import { CHORD_NAMES, STRINGS } from '../lib/ukulele';

/* The secret ukulele. On every page, since the sequence can end anywhere. It closes only with Close or Esc:
   a click outside must not end a strum by accident (his request). */
---

<dialog class="uke k-home" data-ukulele aria-label="Ukulele mode">
  <div class="gbar">
    <Icon name="music" class="size-[18px] text-door" />
    <b>Ukulele mode</b>
    <button type="button" class="close" data-uke-close data-sound="low">Close</button>
  </div>
  <div class="ubody">
    <p class="ukp">
      You just played G, C, E, A three times. Those are a ukulele's open strings. Sweep across the strings, tap them, or press 1 to 4.
    </p>
    <div class="neck" data-neck>
      {
        STRINGS.map((name, s) => (
          <button type="button" class="ustr" data-string={s} aria-label={`String ${name}`} data-sound="none">
            <span class="sn">{name}</span>
            <i />
            <span class="fr" data-fret>0</span>
          </button>
        ))
      }
    </div>
    <div class="chords" role="group" aria-label="Chord">
      {
        CHORD_NAMES.map((c) => (
          <button type="button" class="chip" data-chord={c} aria-pressed={c === 'Open' ? 'true' : 'false'} data-sound="none">
            {c}
          </button>
        ))
      }
    </div>
    <div class="ukact">
      <button type="button" class="play-btn" data-strum data-sound="none"><Icon name="play" class="size-3 fill-current stroke-none" />Strum</button>
      <button type="button" class="four" data-four data-sound="none">The four chords of every pop song</button>
    </div>
  </div>
</dialog>

<style>
  .uke {
    width: min(560px, calc(100% - 32px));
    margin: auto;
    padding: 0;
    color: var(--ink);
    background: var(--raise);
    border: 1px solid var(--c);
    border-radius: 10px;
  }
  .uke[open] { animation: a-pop 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .uke::backdrop { background: rgb(5 8 12 / 0.72); }
  .gbar { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--rule); }
  .gbar b { flex: 1; font-weight: 600; font-size: 17px; }
  .close, .four { border: 1px solid var(--rule); border-radius: 6px; padding: 3px 9px; font-size: 14px; color: var(--soft); }
  .ubody { padding: 12px; }
  .ukp { margin: 0 0 12px; color: var(--soft); font-size: 14px; }
  .neck {
    display: grid;
    padding: 8px 0;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--sun) 24%, var(--paper)), color-mix(in srgb, var(--sun) 10%, var(--paper)));
    touch-action: none;
    user-select: none;
  }
  .ustr { display: grid; grid-template-columns: 28px 1fr 28px; align-items: center; gap: 8px; height: 46px; padding: 0 12px; }
  .ustr i { display: block; height: 2px; border-radius: 2px; background: var(--soft); }
  .ustr:nth-child(2) i { height: 3px; }
  .ustr:nth-child(3) i { height: 2.5px; }
  .ustr.hit i { animation: vib 0.5s ease-out; }
  @keyframes vib {
    0% { background: var(--grass); transform: translateY(-3px); }
    20% { transform: translateY(3px); }
    40% { transform: translateY(-2px); }
    60% { transform: translateY(1px); }
    100% { transform: none; }
  }
  .sn { font-weight: 700; color: var(--c); }
  .fr { color: var(--soft); font-size: 12px; text-align: right; font-variant-numeric: tabular-nums; }
  .chords { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0; }
  .chip { border: 1px solid var(--rule); border-radius: 999px; background: var(--paper); padding: 2px 12px; font-size: 14px; font-weight: 500; color: var(--soft); }
  .chip[aria-pressed='true'] { border-color: var(--c); color: var(--ink); background: color-mix(in srgb, var(--c) 14%, var(--paper)); }
  .ukact { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  @media (prefers-reduced-motion: reduce) {
    .uke[open], .ustr.hit i { animation: none; }
  }
</style>

<script>
  import { isSoundOn, pluckHz } from '../lib/sound';
  import { CHORDS, stringHz, type ChordName } from '../lib/ukulele';

  let chord: ChordName = 'Open';
  let timers: number[] = [];
  let lastString: Element | null = null;

  const dialog = () => document.querySelector<HTMLDialogElement>('dialog[data-ukulele]');
  const clearTimers = () => {
    timers.forEach(clearTimeout);
    timers = [];
  };

  function pluckString(s: number): void {
    pluckHz(stringHz(s, chord));
    const el = dialog()?.querySelector(`[data-string="${s}"]`);
    if (el) {
      el.classList.remove('hit');
      void (el as HTMLElement).offsetWidth;
      el.classList.add('hit');
    }
  }

  /** Down: G to A. Up: A to G. */
  const strum = (up = false) => [0, 1, 2, 3].forEach((i) => timers.push(window.setTimeout(() => pluckString(up ? 3 - i : i), i * 22)));

  function setChord(c: ChordName): void {
    chord = c;
    const d = dialog();
    if (!d) return;
    d.querySelectorAll<HTMLElement>('[data-chord]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.chord === c)));
    d.querySelectorAll<HTMLElement>('[data-string]').forEach((b) => {
      b.querySelector('[data-fret]')!.textContent = String(CHORDS[c][Number(b.dataset.string)]);
    });
  }

  /** C, G, Am, F and back to C: a down strum on each, an up strum between. */
  function fourChords(): void {
    clearTimers();
    (['C', 'G', 'Am', 'F', 'C'] as ChordName[]).forEach((c, i) => {
      timers.push(window.setTimeout(() => { setChord(c); strum(); }, i * 900));
      if (i < 4) timers.push(window.setTimeout(() => strum(true), i * 900 + 450));
    });
  }

  /* Opened by ui.ts when the bar sequence completes (with sound on). */
  window.addEventListener('assaf:ukulele', () => {
    const d = dialog();
    if (!d || d.open || !isSoundOn()) return;
    clearTimers();
    setChord('Open');
    d.showModal();
    strum();
  });

  document.addEventListener('click', (e) => {
    const d = dialog();
    const target = e.target as Element;
    if (!d || !d.contains(target)) return; // a click on the dim area outside does nothing
    const b = target.closest<HTMLElement>('button');
    if (!b) return;
    if (b.hasAttribute('data-uke-close')) {
      clearTimers();
      d.close();
    } else if (b.dataset.chord) {
      clearTimers();
      setChord(b.dataset.chord as ChordName);
      strum();
    } else if (b.hasAttribute('data-strum')) strum();
    else if (b.hasAttribute('data-four')) fourChords();
    else if (b.dataset.string && e.detail === 0) pluckString(Number(b.dataset.string)); // keyboard Enter/Space
  });

  /* Sweep or tap: a string sounds when the pointer enters it (mouse) or touches it (finger). */
  document.addEventListener('pointerdown', (e) => {
    const s = (e.target as Element).closest?.('dialog[data-ukulele] [data-string]');
    if (s) {
      pluckString(Number((s as HTMLElement).dataset.string));
      lastString = s;
    }
  });
  document.addEventListener('pointermove', (e) => {
    const d = dialog();
    if (!d?.open) return;
    const s = document.elementFromPoint(e.clientX, e.clientY)?.closest('dialog[data-ukulele] [data-string]') ?? null;
    if (s && s !== lastString) pluckString(Number((s as HTMLElement).dataset.string));
    lastString = s;
  });

  document.addEventListener('keydown', (e) => {
    const d = dialog();
    if (!d?.open) return;
    if (e.key >= '1' && e.key <= '4') pluckString(Number(e.key) - 1);
    else if (e.key === ' ' && !(e.target as Element).closest('button')) {
      e.preventDefault();
      strum();
    }
  });

  document.addEventListener('close', (e) => {
    if ((e.target as Element).matches?.('dialog[data-ukulele]')) clearTimers();
  }, true);
</script>

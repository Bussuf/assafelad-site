---
import Icon from './Icon.astro';
import { NAV, type NavKey } from '../lib/nav';

interface Props {
  current: NavKey;
}

const { current } = Astro.props;
---

<!-- Phone navigation: a floating bar at the bottom, hidden from 700px up where the header tabs take over. -->
<div class="pointer-events-none fixed inset-x-0 bottom-[calc(12px+env(safe-area-inset-bottom,0px))] z-10 flex justify-center nav:hidden">
  <nav
    aria-label="Main"
    class="hotbar pointer-events-auto flex gap-[5px] rounded-2xl bg-cloud p-1.5"
  >
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            `k-${item.key} grid h-[54px] w-[58px] content-center justify-items-center gap-0.5 rounded-xl border text-[11px] font-medium transition-transform active:scale-95`,
            // every slot shows its door color, so the bar reads as the site's controls, not as page content
            current === item.key
              ? 'border-door bg-door text-[var(--c-on)]'
              : 'border-rule bg-raise text-ink [&_svg]:text-door',
          ]}
          aria-current={current === item.key ? 'page' : undefined}
          data-sound={item.sound}
          data-nav={item.key}
        >
          <Icon name={item.key} class="size-5" />
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  /* stands apart from the page: lighter than the content, a clear edge and a deep shadow */
  .hotbar {
    border: 1.5px solid color-mix(in srgb, var(--ink) 28%, transparent);
    box-shadow: 0 14px 34px -8px rgb(0 0 0 / 0.75), 0 0 0 4px color-mix(in srgb, var(--paper) 70%, transparent);
  }
</style>

---
import Icon from './Icon.astro';
import { NAV, type NavKey } from '../lib/nav';

interface Props {
  current: NavKey;
}

const { current } = Astro.props;
---

<!-- Phone navigation: a floating bar at the bottom, hidden from 700px up where the header tabs take over. -->
<div class="pointer-events-none fixed inset-x-0 bottom-[calc(12px+env(safe-area-inset-bottom,0px))] z-10 flex justify-center nav:hidden">
  <nav
    aria-label="Main"
    class="hotbar pointer-events-auto flex gap-[5px] rounded-2xl p-1.5"
  >
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            `slot k-${item.key} grid h-[54px] w-[58px] content-center justify-items-center gap-0.5 rounded-xl bg-door text-[11px] font-semibold text-[var(--c-on)] transition-transform`,
            current === item.key && 'here',
          ]}
          aria-current={current === item.key ? 'page' : undefined}
          data-sound={item.sound}
          data-nav={item.key}
        >
          <Icon name={item.key} class="size-5" />
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  /* Option C (his pick): an inverted frame - the ink color, light on the dark theme and dark on the light one -
     with every slot filled in its door color, so the bar never blends into the page. */
  .hotbar {
    background: var(--ink);
    /* short and tight: a wider spread reached Android's system bar and was cut there (his note) */
    box-shadow: 0 3px 8px -2px rgb(0 0 0 / 0.38), 0 0 0 3px color-mix(in srgb, var(--paper) 80%, transparent);
  }
  .slot { opacity: 0.82; }
  /* light theme: the dimmed slots looked shaded on the dark frame, so they stay nearly full */
  :global(:root[data-theme='light']) .slot { opacity: 0.94; }
  /* where you are: full color, lifted, with a ring in the page color */
  .slot.here {
    opacity: 1;
    transform: translateY(-4px);
    box-shadow: 0 0 0 2.5px var(--paper), 0 0 0 4.5px var(--c);
  }
</style>

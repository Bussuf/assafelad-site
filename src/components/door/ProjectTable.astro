---
import Placeholder from '../Placeholder.astro';
import PlayButton from '../project/PlayButton.astro';
import { langOf, projectHref, type Project } from '../../lib/projects';

interface Props {
  items: Project[];
}

const { items } = Astro.props;
const playCol = items.some((p) => p.data.play);
---

<table class="w-full border-collapse text-[14.5px] tabular-nums">
  <thead>
    <tr class="border-b-2 border-rule text-left text-[13px] text-soft">
      <th class="w-[76px] px-2 py-1.5 font-medium"><span class="sr-only">Image</span></th>
      <th class="px-2 py-1.5 font-medium">Project</th>
      <th class="px-2 py-1.5 font-medium">Status</th>
      <th class="hidden px-2 py-1.5 font-medium nav:table-cell">Made with</th>
      {playCol && <th class="hidden px-2 py-1.5 nav:table-cell"><span class="sr-only">Play</span></th>}
    </tr>
  </thead>
  <tbody>
    {
      items.map((p) => (
        <tr class="border-b border-rule hover:bg-cloud" data-card data-status={p.data.status}>
          <td class="px-2 py-2">
            <div class="w-16">
              <Placeholder caption={p.data.hero.caption} file={p.data.hero.file} kind={p.data.hero.kind} ratio="4:3" size="tiny" />
            </div>
          </td>
          <td class="px-2 py-2">
            <a href={projectHref(p)} class="text-link underline underline-offset-2">
              <bdi lang={langOf(p.data.name)}>{p.data.name}</bdi>
            </a>
          </td>
          <td class="px-2 py-2">
            <span class:list={['st', p.data.state]}>{p.data.status}</span>
          </td>
          <td class="hidden px-2 py-2 nav:table-cell">{p.data.made}</td>
          {playCol && (
            <td class="hidden px-2 py-2 nav:table-cell">
              <PlayButton project={p} />
            </td>
          )}
        </tr>
      ))
    }
  </tbody>
</table>

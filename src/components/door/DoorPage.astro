---
import Icon from '../Icon.astro';
import Placeholder from '../Placeholder.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectTable from './ProjectTable.astro';
import GameWindow from '../project/GameWindow.astro';
import { DOORS } from '../../data/home';
import { countLine, projectsOf, type DoorKey } from '../../lib/projects';

/* A door page (Shelf): header, status filter, Grid / Table. Without JavaScript: all items in the Grid. */
interface Props {
  door: DoorKey;
}

const door = DOORS.find((d) => d.key === Astro.props.door)!;
const items = await projectsOf(door.key);
const statuses = [...new Set(items.map((p) => p.data.status))];
const motions = ['zoom', 'pop', 'right', 'drop', 'up', 'pop'];
const chip = 'rounded-full border border-rule bg-paper px-3 py-0.5 text-sm font-medium text-soft';
const seg = 'inline-flex items-center gap-[5px] px-2.5 py-[3px] text-[13.5px] text-soft';
---

<div class={`k-${door.key} pb-4`} data-shelf>
  <!-- the cover is small on a computer (his call, #12), so one row of cards fits the screen -->
  <div class="grid items-center gap-6 pt-[18px] pb-3 nav:grid-cols-[minmax(0,1fr)_minmax(0,340px)]">
    <div>
      <span class="inline-flex items-center gap-2 text-[15px] font-semibold text-door" data-a="left" style="--d:40ms">
        <Icon name={door.key} class="size-[22px]" />{countLine(door.key, items)}
      </span>
      <h1
        class="mt-1.5 mb-1 text-[clamp(34px,4.5vw,52px)] leading-[1.08] font-extrabold tracking-[-0.015em]"
        data-a="left"
        style="--d:90ms"
      >
        {door.title}
      </h1>
      <p class="mb-0 max-w-[60ch] text-[17px] text-soft" data-a="up" style="--d:150ms">{door.intro}</p>
    </div>
    <div data-a="zoom" style="--d:60ms">
      <Placeholder caption={door.cover.caption} file={door.cover.file} kind={door.cover.kind} ratio="16:9" />
    </div>
  </div>

  <div class="mb-1 flex flex-wrap items-center justify-between gap-2.5" data-a="up" style="--d:180ms">
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by status">
      <button type="button" class={chip} data-filter="" aria-pressed="true">All</button>
      {statuses.map((s) => <button type="button" class={chip} data-filter={s} aria-pressed="false">{s}</button>)}
    </div>
    <div class="inline-flex overflow-hidden rounded-md border border-rule" role="group" aria-label="View" data-js-only hidden>
      <button type="button" class={seg} data-layout="grid" aria-pressed="true"><Icon name="grid" class="size-[15px]" />Grid</button>
      <button type="button" class:list={[seg, 'border-l border-rule']} data-layout="table" aria-pressed="false"
        ><Icon name="table" class="size-[15px]" />Table</button
      >
    </div>
  </div>
  <p class="mt-2 mb-1.5 text-[13.5px] text-soft" data-count aria-live="polite">{items.length} of {items.length}</p>

  <div
    class="mt-2.5 grid grid-cols-2 gap-2.5 nav:grid-cols-[repeat(auto-fill,minmax(220px,1fr))] nav:gap-4"
    data-view="grid"
  >
    {items.map((p, i) => <ProjectCard project={p} motion={motions[i % motions.length]} delay={220 + i * 70} />)}
  </div>
  <div class="overflow-x-auto" data-view="table" hidden>
    <ProjectTable items={items} />
  </div>

  {items.map((p) => <GameWindow project={p} />)}
</div>

<style>
  [aria-pressed='true'][data-filter] {
    border-color: var(--c);
    color: var(--ink);
    background: color-mix(in srgb, var(--c) 14%, var(--paper));
  }
  [aria-pressed='true'][data-layout] { background: var(--cloud); color: var(--ink); }
</style>

<script>
  const LAYOUT_KEY = 'assaf-layout';

  /* Filter and Grid/Table. Re-run on every page load (ClientRouter); the layout choice is remembered. */
  function setup(): void {
    const shelf = document.querySelector<HTMLElement>('[data-shelf]');
    if (!shelf) return;
    shelf.querySelector('[data-js-only]')?.removeAttribute('hidden');
    let filter = '';
    let layout = 'grid';
    try {
      if (localStorage.getItem(LAYOUT_KEY) === 'table') layout = 'table';
    } catch {
      // not remembered
    }

    const apply = () => {
      shelf.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => (v.hidden = v.dataset.view !== layout));
      const view = shelf.querySelector<HTMLElement>(`[data-view="${layout}"]`)!;
      const cards = [...view.querySelectorAll<HTMLElement>('[data-card]')];
      cards.forEach((c) => (c.hidden = !!filter && c.dataset.status !== filter));
      shelf.querySelector('[data-count]')!.textContent = `${cards.filter((c) => !c.hidden).length} of ${cards.length}`;
      shelf.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.filter === filter)));
      shelf.querySelectorAll('[data-layout]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.layout === layout)));
    };

    shelf.addEventListener('click', (event) => {
      const btn = (event.target as Element).closest<HTMLElement>('[data-filter], [data-layout]');
      if (!btn) return;
      if (btn.dataset.layout) {
        layout = btn.dataset.layout;
        try {
          localStorage.setItem(LAYOUT_KEY, layout);
        } catch {
          // still switched for this visit
        }
      } else {
        filter = btn.dataset.filter ?? '';
      }
      apply();
    });
    apply();
  }

  document.addEventListener('astro:page-load', setup);
</script>

---
import { Image, getImage } from 'astro:assets';
import Placeholder from '../Placeholder.astro';
import { findImage, findVideo } from '../../lib/images';
import type { Project } from '../../lib/projects';

/* One big image and a row of thumbnails under it: a thumbnail swaps the big image in place, no scrolling.
   The big image is shown whole (contain) on a blurred copy of itself, so any shape fits. */
interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;
// every image of the project: the row of thumbnails scrolls sideways when they do not fit
const shots = [project.data.hero, ...project.data.gallery];
// A video slot (#15): nothing loads until Play (preload none), so the page stays light on a phone; the cover is
// a frame from the video, resized like any image.
const videos = await Promise.all(
  shots.map(async (s) => {
    if (!s.video) return undefined;
    const cover = findImage(s.file);
    if (!cover) throw new Error(`A video needs its cover picture in src/assets/images/: ${s.file}`);
    const poster = await getImage({ src: cover, width: Math.min(720, cover.width), format: 'webp' });
    return { url: findVideo(s.video), poster: poster.src };
  }),
);
---

<section class:list={['viewer', className]} aria-label="Gallery" data-viewer>
  <div class="stage">
    {
      shots.map((s, i) => {
        const img = findImage(s.file);
        const video = videos[i];
        return (
          <figure class:list={['slide', { 'is-video': video }]} data-slide={i} hidden={i !== 0}>
            {video && img ? (
              <>
                <Image src={img} alt="" width={Math.min(720, img.width)} class="bg" aria-hidden="true" loading="lazy" />
                <video class="fg" src={video.url} poster={video.poster} controls playsinline preload="none" aria-label={s.caption} />
              </>
            ) : img ? (
              <>
                <Image src={img} alt="" width={Math.min(1280, img.width)} class="bg" aria-hidden="true" loading={i === 0 ? 'eager' : 'lazy'} />
                <Image src={img} alt={s.caption} width={Math.min(1280, img.width)} class="fg" loading={i === 0 ? 'eager' : 'lazy'} />
              </>
            ) : (
              <Placeholder caption={s.caption} file={s.file} kind={s.kind} ratio="16:9" class="fill" />
            )}
            <figcaption>{s.caption} · {i + 1} of {shots.length}</figcaption>
          </figure>
        );
      })
    }
  </div>
  {
    shots.length > 1 && (
      <div class="strip" data-strip>
        <button type="button" class="arrow" data-scroll="-1" aria-label="Earlier images" hidden>‹</button>
        <div class="thumbs" role="group" aria-label="Choose an image" data-thumbs>
          {shots.map((s, i) => (
            <button type="button" class="thumb" data-show={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={s.video ? `${s.caption} (video)` : s.caption}>
              <Placeholder caption={s.caption} file={s.file} kind={s.kind} ratio="4:3" size="tiny" />
              {s.video && <span class="play-mark" aria-hidden="true">▶</span>}
            </button>
          ))}
        </div>
        <button type="button" class="arrow" data-scroll="1" aria-label="More images" hidden>›</button>
      </div>
    )
  }
</section>

<style>
  .viewer { display: flex; flex-direction: column; gap: 10px; min-height: 0; }
  .stage { position: relative; flex: 1; min-height: 260px; aspect-ratio: 16 / 10; border-radius: 10px; overflow: hidden; background: #0d121a; }
  /* desktop: the stage takes the height that is left, so the page fits one screen */
  @media (min-width: 43.75rem) {
    .stage { aspect-ratio: auto; }
  }
  .slide { position: absolute; inset: 0; margin: 0; }
  .slide :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .slide :global(img.bg) { object-fit: cover; filter: blur(26px) brightness(0.4); transform: scale(1.2); }
  .slide :global(img.fg) { object-fit: contain; }
  .slide video { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: contain; }
  /* the player's own controls sit at the bottom: the caption moves to the top */
  .is-video figcaption { top: 10px; bottom: auto; }
  .slide :global(.fill) { position: absolute; inset: 0; aspect-ratio: auto; height: 100%; }
  figcaption {
    position: absolute;
    left: 12px;
    bottom: 10px;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgb(13 18 26 / 0.8);
    color: #e9eef5;
    font-size: 13px;
  }
  /* Always one row (his rule, #14): extra thumbnails scroll sideways with arrow buttons; no visible scrollbar. */
  .strip { display: flex; align-items: center; gap: 6px; min-width: 0; }
  .thumbs {
    display: flex;
    gap: 8px;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .thumbs::-webkit-scrollbar { display: none; }
  .thumb { position: relative; flex: none; width: 96px; scroll-snap-align: start; padding: 0; border: 2px solid var(--rule); border-radius: 7px; overflow: hidden; background: #0d121a; }
  /* a video thumbnail says so: a play mark in the middle */
  .play-mark {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding-left: 2px;
    border-radius: 50%;
    background: rgb(13 18 26 / 0.75);
    color: #e9eef5;
    font-size: 12px;
    line-height: 1;
  }
  .arrow {
    flex: none;
    width: 36px;
    align-self: stretch;
    border: 1px solid var(--rule);
    border-radius: 7px;
    background: var(--raise);
    color: var(--c);
    font-size: 22px;
    line-height: 1;
  }
  .arrow[hidden] { display: none; }
  .arrow[data-off] { visibility: hidden; }
  @media (hover: hover) and (pointer: fine) {
    .arrow:hover { border-color: var(--c); background: color-mix(in srgb, var(--c) 14%, var(--raise)); }
  }
  /* "selected", the same language as the About topics and the room list: the door color frames it and it is
     the only one in full; a picture has no room for a tint, so the others step back a little instead */
  .thumb { transition: opacity 0.15s, border-color 0.15s; opacity: 0.72; }
  .thumb[aria-pressed='true'] { border-color: var(--c); box-shadow: 0 0 0 1px var(--c); opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    /* a picture cannot take a fill: on hover it comes forward to full, with the door-color frame */
    .thumb:hover { border-color: var(--c); opacity: 1; }
  }
  @media (max-width: 43.74rem) {
    /* a phone shows four at a time */
    .thumb { width: calc((100% - 24px) / 4); }
    .arrow { width: 40px; }
  }
</style>

<script>
  /* The arrows show only when there are more thumbnails than fit, and only toward the hidden side. */
  function syncArrows(strip: Element): void {
    const row = strip.querySelector<HTMLElement>('[data-thumbs]')!;
    const more = row.scrollWidth > row.clientWidth + 2;
    const [back, fwd] = strip.querySelectorAll<HTMLElement>('[data-scroll]');
    // With overflow both arrows keep their place, so the row never changes width while scrolling (his note, #14 follow-up)
    back!.hidden = fwd!.hidden = !more;
    back!.toggleAttribute('data-off', row.scrollLeft <= 2);
    fwd!.toggleAttribute('data-off', row.scrollLeft + row.clientWidth >= row.scrollWidth - 2);
  }
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-strip]').forEach((strip) => {
      syncArrows(strip);
      strip.querySelector('[data-thumbs]')!.addEventListener('scroll', () => syncArrows(strip), { passive: true });
    });
  });
  addEventListener('resize', () => document.querySelectorAll('[data-strip]').forEach(syncArrows));

  /* Delegated, so it works after every page swap. */
  document.addEventListener('click', (e) => {
    const arrow = (e.target as Element).closest<HTMLElement>('[data-strip] [data-scroll]');
    if (arrow) {
      const row = arrow.closest('[data-strip]')!.querySelector<HTMLElement>('[data-thumbs]')!;
      row.scrollBy({ left: Number(arrow.dataset.scroll) * row.clientWidth * 0.8 });
      return;
    }
    const btn = (e.target as Element).closest<HTMLElement>('[data-viewer] [data-show]');
    if (!btn) return;
    const viewer = btn.closest('[data-viewer]')!;
    const n = btn.dataset.show;
    viewer.querySelectorAll<HTMLElement>('[data-slide]').forEach((s) => {
      s.hidden = s.dataset.slide !== n;
      // a video that is moved away from stops, so two never play at once
      if (s.hidden) s.querySelector('video')?.pause();
    });
    viewer.querySelectorAll('[data-show]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    btn.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  });
</script>
